RSS_SERVICE_HOST=localhost
RSS_SERVICE_PORT=3006
RSS_SERVICE_NATS_SERVERS=nats://localhost:4222

# Url vers le flux RSS d'informations à afficher
RSS_SERVICE_FEED_URL=http://localhost:3099/mocking/rss
# Tags HTML autorisés dans le contenu de l'information
RSS_SERVICE_ALLOWED_HTML_TAGS=b,strong,i,italic,ol,ul,li

# RECUPERATION DU FLUX
# Délai maximum d'une requête vers le flux, en millisecondes
RSS_SERVICE_FEED_TIMEOUT_MS=15000
# Nombre de nouvelles tentatives après un échec (0 = aucune)
RSS_SERVICE_FEED_RETRY_COUNT=1
# Délai avant une nouvelle tentative, en millisecondes
RSS_SERVICE_FEED_RETRY_DELAY_MS=1000
# User-Agent envoyé au serveur du flux (défaut : <nom du service>/<version>)
RSS_SERVICE_FEED_USER_AGENT=
# Âge maximum du dernier flux valide servi quand la récupération échoue,
# en millisecondes (0 = désactive ce repli). Défaut : 24h
RSS_SERVICE_FEED_STALE_MAX_AGE_MS=86400000

# PROXY SORTANT
# Proxy à utiliser pour joindre le flux. Vide = connexion directe.
# À défaut, HTTPS_PROXY / https_proxy / HTTP_PROXY / http_proxy sont utilisées.
RSS_SERVICE_HTTPS_PROXY=

# CACHE
# Durée de vie du flux en cache, en millisecondes (0 = pas de cache)
RSS_SERVICE_CACHE_TTL_MS=300

vars:
  BUNDLE_ID:
    default: fr.esupportail.mobile.multi
  PACKAGE_NAME:
    default: fr.esupportail.mobile.multi
  VERSION_NAME:
    default: "1.0.0"
  ANDROID_VERSION_NAME:
    default: "1.0.0"
  ANDROID_VERSION_CODE:
    default: "1"
  IOS_BUILD_NUMBER:
    default: "1"

platforms:
  android:
    packageName: $PACKAGE_NAME
    versionName: $ANDROID_VERSION_NAME
    versionCode: $ANDROID_VERSION_CODE
    # Exclut le stockage sécurisé (jetons de connexion, comptes TOTP) des sauvegardes et transferts Android :
    res:
      - path: xml
        file: backup_rules.xml
        text: |
          <?xml version="1.0" encoding="utf-8"?>
          <full-backup-content>
            <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
          </full-backup-content>
      - path: xml
        file: data_extraction_rules.xml
        text: |
          <?xml version="1.0" encoding="utf-8"?>
          <data-extraction-rules>
            <cloud-backup>
              <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
            </cloud-backup>
            <device-transfer>
              <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
            </device-transfer>
          </data-extraction-rules>
    manifest:
      - file: AndroidManifest.xml
        target: manifest/application
        attrs:
          android:fullBackupContent: '@xml/backup_rules'
          android:dataExtractionRules: '@xml/data_extraction_rules'
    # Décommenter le bloc si utilisation des notifications
    #copy:
    #  - src: ../src/environments/firebase/android/google-services-prod.json
    #    dest: app/google-services.json

  ios:
    bundleId: $BUNDLE_ID
    version: $VERSION_NAME
    buildNumber: $IOS_BUILD_NUMBER
    # Décommenter le bloc si utilisation des notifications
    #copy:
    #  - src: ../../src/environments/firebase/ios/GoogleService-Info-prod.plist
    #    dest: App/GoogleService-Info.plist

{
  "name": "multi-cms-connector",
  "version": "1.3.0",
  "description": "Connecteur permettant d'interfacer le backend de Multi avec le CMS de son choix",
  "author": "Université de Lorraine",
  "license": "CeCILL-2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@golevelup/nestjs-graphql-request": "^5.0.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "envalid": "^8.1.0",
    "graphql-request": "^7.2.0",
    "graphql-type-json": "^0.3.2",
    "joi": "^18.2.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.0"
  },
  "imports": {
    "#common/*": "./dist/common/*",
    "#directus/*": "./dist/cms/directus/*",
    "#wordpress/*": "./dist/cms/wordpress/*",
    "#cache/*": "./dist/cache/*",
    "#redis/*": "./dist/redis/*"
  }
}
